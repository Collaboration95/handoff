# Copy this file to the repository root as .env.local. Do not commit that file.
OPENAI_API_KEY=
FINANCE_MODEL=gpt-4.1-mini

# Optional hosted tracing. Both keys are required for hosted status.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Official Airwallex CLI. Omit when `airwallex` is on PATH or .tools/airwallex exists.
AIRWALLEX_CLI_PATH=
AIRWALLEX_LEGAL_ENTITY_ID=

# Direct LiveKit participant connection for the voice bridge.
LIVEKIT_URL=
LIVEKIT_TOKEN=
LIVEKIT_ROOM=handoff-finance
FINANCE_API_URL=http://127.0.0.1:8000
